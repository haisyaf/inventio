// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// TABLES

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  email     String
  phone     String
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  invites           Invite[]
  categories        Category[]
  products          Product[]
  warehouses        Warehouse[]
  suppliers         Supplier[]
  stocks            Stock[]
  transaction_types TransactionType[]
  transactions      Transaction[]
  stockMovements    StockMovement[]
  subscriptions     Subscription[]
  forecasts         Forecast[]
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  transactions Transaction[]
}

model Invite {
  id        String   @id @default(uuid())
  tenantId  String
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model Category {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String
  categoryId  String
  name        String
  description String
  price       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  stocks           Stock[]
  transactionItems TransactionItem[]
  stockMovements   StockMovement[]
  forecasts        Forecast[]
}

model Warehouse {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  location    String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  stocks         Stock[]
  transactions   Transaction[]
  stockMovements StockMovement[]
}

model Supplier {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  email     String
  phone     String
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  transactions Transaction[]
}

model Stock {
  id          String   @id @default(uuid())
  tenantId    String
  productId   String
  warehouseId String
  quantity    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
}

model TransactionType {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  code         String   @unique
  direction    String
  affectsStock Boolean
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  transactions Transaction[]
}

model Transaction {
  id          String   @id @default(uuid())
  tenantId    String
  warehouseId String
  supplierId  String
  typeId      String
  createdBy   String
  description String
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  warehouse     Warehouse       @relation(fields: [warehouseId], references: [id])
  supplier      Supplier        @relation(fields: [supplierId], references: [id])
  type          TransactionType @relation(fields: [typeId], references: [id])
  createdByUser User            @relation(fields: [createdBy], references: [id])

  items          TransactionItem[]
  stockMovements StockMovement[]
}

model TransactionItem {
  id            String   @id @default(uuid())
  transactionId String
  productId     String
  quantity      Int
  price         Float
  subtotal      Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])
}

model StockMovement {
  id             String   @id @default(uuid())
  tenantId       String
  transactionId  String
  warehouseId    String
  productId      String
  quantity       Int
  type           String
  beforeQuantity Int
  afterQuantity  Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  transaction Transaction @relation(fields: [transactionId], references: [id])
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])
}

model Subscription {
  id        String             @id @default(uuid())
  tenantId  String
  planId    String
  startDate DateTime
  endDate   DateTime
  status    SubscriptionStatus
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])
}

model SubscriptionPlan {
  id        String   @id @default(uuid())
  name      String
  features  Json
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

model Forecast {
  id        String @id @default(uuid())
  tenantId  String
  productId String

  type          ForecastType // Jenis forecast, misal: STOCK_DEMAND
  forecastValue Float // Nilai prediksi, misal: 28 atau 550000
  unit          String // Satuan, misal: "units" atau "IDR"
  forecastDate  DateTime // Tanggal prediksi

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

// ENUMS
enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum UserRole {
  ADMIN
  MEMBER
}

enum ForecastType {
  STOCK_DEMAND
  SALES_REVENUE
  PURCHASE_COST
}
